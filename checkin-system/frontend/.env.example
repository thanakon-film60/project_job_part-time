# ===================================================================
# production (เสิร์ฟจาก IIS หลัง Cloudflare Tunnel)
# ปล่อยว่าง = เรียก API ที่โดเมนเดียวกัน เช่น /auth/login, /reports/calendar
# IIS จะส่งต่อไป backend ให้เอง (same-origin ไม่ต้องกังวลเรื่อง CORS)
# ===================================================================
VITE_API_BASE=

# ===================================================================
# ตอนพัฒนาบนเครื่องตัวเอง (รัน vite dev + uvicorn แยกกัน)
# ให้ใช้บรรทัดนี้แทน
# ===================================================================
# VITE_API_BASE=http://localhost:8002
