# คัดลอกเป็น .env (ไฟล์นี้ถูก git ignore ไว้แล้ว)
# docker compose อ่านไฟล์นี้อัตโนมัติ เพราะอยู่โฟลเดอร์เดียวกับ docker-compose.yml
# ⚠️ บันทึกเป็น UTF-8 ไม่มี BOM

# --- PostgreSQL ที่รันใน container ---
# คนละตัวกับ PostgreSQL 16 บนเครื่อง (127.0.0.1:5432) ที่ production ใช้อยู่
POSTGRES_USER=thanakon_app
POSTGRES_PASSWORD=เปลี่ยนเป็นรหัสของคุณ
POSTGRES_DB=thanakon_room

# --- พอร์ตฝั่ง Windows (ต้องไม่ชนกับที่ใช้อยู่: 5432, 8000, 8001, 80) ---
DB_HOST_PORT=5433
API_HOST_PORT=8010

# --- ค่าที่ override ทับ backend/.env เฉพาะตอนรันใน Docker ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true เมื่อไหร่ container จะยิงแจ้งเตือนเข้ากลุ่ม LINE จริง — ตอนทดสอบให้เป็น false
LINE_NOTIFY_ENABLED=false
CAMERA_PTZ_ENABLED=false
