# คัดลอกเป็น .env (ไฟล์นี้ถูก git ignore ไว้แล้ว)
# docker compose อ่านไฟล์นี้อัตโนมัติ เพราะอยู่โฟลเดอร์เดียวกับ docker-compose.yml
# ⚠️ บันทึกเป็น UTF-8 ไม่มี BOM

# --- PostgreSQL ที่รันใน container ---
# คนละตัวกับ PostgreSQL 16 บนเครื่อง (127.0.0.1:5432) ที่ production ใช้อยู่
POSTGRES_USER=thanakon_app
POSTGRES_PASSWORD=เปลี่ยนเป็นรหัสของคุณ
POSTGRES_DB=thanakon_room

# --- พอร์ตฝั่ง Windows (ต้องไม่ชนกับที่ใช้อยู่: 5432, 8000, 8001, 80) ---
DB_HOST_PORT=5433
API_HOST_PORT=8010

# --- ค่าที่ override ทับ backend/.env เฉพาะตอนรันใน Docker ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true เมื่อไหร่ container จะยิงแจ้งเตือนเข้ากลุ่ม LINE จริง — ตอนทดสอบให้เป็น false
LINE_NOTIFY_ENABLED=false
CAMERA_PTZ_ENABLED=false

# --- สถานที่ทำงาน (JSON บรรทัดเดียว) ---
# ย้ายบริษัทเมื่อไหร่ให้แก้ที่บรรทัดนี้บรรทัดเดียว ไม่ต้อง build แอปใหม่
OFFICES=[{"name":"Motta & Montipa (Head office)","lat":13.9040518,"lng":100.5391995,"radius_km":0.5,"category":"work"},{"name":"\u0e16\u0e36\u0e07\u0e1a\u0e49\u0e32\u0e19\u0e41\u0e25\u0e49\u0e27","lat":13.8865664,"lng":100.5066278,"radius_km":0.2,"allow_checkout":false,"category":"home"}]

# --- เวลาทำงาน (เวลาไทย) ใช้ตัดสิน สาย / ออกก่อน ---
WORK_START_TIME=08:30
WORK_END_TIME=17:30
# ผ่อนผันกี่นาทีถึงเริ่มนับว่าสาย (0 = เข้าหลัง 08:30 น. สายทันที)
LATE_GRACE_MINUTES=0
EARLY_LEAVE_GRACE_MINUTES=0
# false = ปิดการตัดสินสาย/ออกก่อน ข้อความแจ้งเตือนกลับไปเป็นแบบเดิม
ATTENDANCE_RULES_ENABLED=true
