<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS config สำหรับเว็บไซต์เดียวที่ทำ 2 อย่าง:
  1) เสิร์ฟไฟล์ React ที่ build แล้ว (จากโฟลเดอร์นี้)
  2) reverse proxy ไปยัง backend uvicorn ที่ 127.0.0.1:8001

  ⚠️ ไม่มี /api นำหน้าแล้ว — เรียก API ได้ตรง ๆ เช่น
        https://api.thanakronpart-time.com/auth/login
        https://api.thanakronpart-time.com/reports/calendar
     จึงต้องแยกด้วย "ชื่อ path ตัวแรก" ว่าอันไหนของ API อันไหนของหน้าเว็บ

  ⚠️ ถ้าเพิ่ม router ใหม่ใน backend (เช่น /shifts) ต้องมาเติมชื่อในกฎ ProxyToBackend ด้วย
     และห้ามตั้งชื่อหน้าเว็บ React ให้ซ้ำกับรายการนั้น
     (เพราะเหตุนี้หน้าประวัติใบหน้าจึงใช้ /face-records ไม่ใช่ /faces)

  หมายเหตุ: /app = ไฟล์ติดตั้งแอป Flutter (APK) ที่ backend เสิร์ฟจาก storage
            ไม่ใช่หน้าเว็บ React จึงห้ามตั้งชื่อ route ของเว็บว่า /app

  หมายเหตุ: ใช้พอร์ต 8001 เพราะ 8000 ถูกโปรเจ็กต์อื่นบนเครื่องนี้ใช้อยู่
            ถ้าย้ายไปเครื่องอื่นที่ 8000 ว่าง เปลี่ยนเลขพอร์ตด้านล่างได้

  ต้องติดตั้งก่อน: URL Rewrite + Application Request Routing (ARR)
  และเปิด proxy: IIS Manager > เครื่อง (root) > Application Request Routing Cache
                 > Server Proxy Settings > ติ๊ก Enable proxy
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <!-- 1) path ที่เป็นของ backend ส่งต่อไปตรง ๆ (ไม่ตัดอะไรออก) -->
        <rule name="ProxyToBackend" stopProcessing="true">
          <match url="^(app|auth|checkins|faces|line|locations|reports|health|docs|redoc|openapi\.json)(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:8001/{R:0}" />
        </rule>

        <!-- 1b) รองรับของเดิมที่ยังเรียกด้วย /api/... ให้ยังใช้ได้อยู่
                (แอปเวอร์ชันเก่าที่ยังไม่ได้อัปเดตจะได้ไม่พัง) -->
        <rule name="ProxyToBackendLegacyApi" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8001/{R:1}" />
        </rule>

        <!-- 2) ไฟล์จริง (js/css/รูป) ให้เสิร์ฟตรง ๆ -->
        <rule name="StaticFiles" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <!-- 3) ที่เหลือส่งไป index.html (React Router / SPA) -->
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- อนุญาตอัปโหลดรูปใบหน้าได้ถึง ~20MB -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="20971520" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />

      <!-- PWA: IIS ไม่รู้จัก .webmanifest มาแต่เดิม ถ้าไม่ประกาศจะตอบ 404
           แล้วมือถือจะติดตั้งเป็นแอปไม่ได้ -->
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

  </system.webServer>

  <!-- service worker ต้องไม่ถูก cache ไม่งั้นพนักงานจะค้างเวอร์ชันเก่าแม้ deploy ใหม่แล้ว
       (ไฟล์ js/css อื่นมี hash อยู่ในชื่อไฟล์ จึง cache ได้ปลอดภัย)
       หมายเหตุ: <location> ต้องอยู่ระดับ <configuration> ห้ามอยู่ใน <system.webServer> -->
  <location path="sw.js">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
