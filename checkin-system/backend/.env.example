# คัดลอกเป็น .env แล้วปรับค่าตามจริง
# ⚠️ ต้องบันทึกเป็น UTF-8 แบบ "ไม่มี BOM" ไม่งั้น python-dotenv จะอ่านคีย์บรรทัดแรกไม่เจอ

# ใช้ SQLite ก็ได้ถ้ายังไม่ได้ติดตั้ง PostgreSQL:  sqlite:///./checkin.db
DATABASE_URL=postgresql://checkin:checkin@localhost:5432/checkin

# พิกัดออฟฟิศ (จากลิงก์ Google Maps: บริษัท มาดูดิ จำกัด)
OFFICE_LAT=13.9231953
OFFICE_LNG=100.5195808
OFFICE_NAME=MARDODI
# รัศมีที่อนุญาตให้เช็คอิน (กิโลเมตร)
GEOFENCE_RADIUS_KM=2.0

# ความปลอดภัย
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# โฟลเดอร์เก็บรูปใบหน้าตอนเช็คอิน
STORAGE_DIR=storage

# โดเมนที่อนุญาตให้เรียก API จากเบราว์เซอร์ (คั่นด้วยจุลภาค, "*" = ทุกโดเมน)
# production ผ่าน Cloudflare Tunnel เป็น same-origin อยู่แล้ว จึงตั้งเป็นโดเมนจริงได้เลย
ALLOWED_ORIGINS=https://thanakronpart-time.com,https://www.thanakronpart-time.com,https://api.thanakronpart-time.com
