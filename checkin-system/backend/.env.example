# คัดลอกเป็น .env แล้วปรับค่าตามจริง
DATABASE_URL=postgresql://checkin:checkin@localhost:5432/checkin

# พิกัดออฟฟิศ (จากลิงก์ Google Maps: บริษัท มาดูดิ จำกัด)
OFFICE_LAT=13.9231953
OFFICE_LNG=100.5195808
OFFICE_NAME=MARDODI
# รัศมีที่อนุญาตให้เช็คอิน (กิโลเมตร)
GEOFENCE_RADIUS_KM=2.0

# ความปลอดภัย
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# โฟลเดอร์เก็บรูปใบหน้าตอนเช็คอิน
STORAGE_DIR=storage
