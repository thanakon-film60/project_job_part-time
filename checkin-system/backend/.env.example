# คัดลอกเป็น .env แล้วปรับค่าตามจริง
# ⚠️ ต้องบันทึกเป็น UTF-8 แบบ "ไม่มี BOM" ไม่งั้น python-dotenv จะอ่านคีย์บรรทัดแรกไม่เจอ

# ใช้ SQLite ก็ได้ถ้ายังไม่ได้ติดตั้ง PostgreSQL:  sqlite:///./checkin.db
DATABASE_URL=postgresql://checkin:checkin@localhost:5432/checkin

# --- สถานที่ที่เช็คอินได้ (รองรับหลายแห่ง) ---
# ต้องเป็น JSON บรรทัดเดียว ห้ามขึ้นบรรทัดใหม่
# ถ้าเว้นว่างไว้ ระบบจะใช้ OFFICE_* ด้านล่างเป็นสถานที่เดียว
OFFICES=[{"name":"Motta & Montipa (Head office)","lat":13.9040518,"lng":100.5391995,"radius_km":0.5,"allow_checkout":true,"category":"work"},{"name":"\u0e16\u0e36\u0e07\u0e1a\u0e49\u0e32\u0e19\u0e41\u0e25\u0e49\u0e27","lat":13.8865664,"lng":100.5066278,"radius_km":0.2,"allow_checkout":false,"category":"home"}]

# --- ค่า fallback ถ้าไม่ได้ตั้ง OFFICES (Motta & Montipa (Head office)) ---
OFFICE_LAT=13.9040518
OFFICE_LNG=100.5391995
OFFICE_NAME=Motta & Montipa (Head office)
# รัศมีที่อนุญาตให้เช็คอิน (กิโลเมตร)
GEOFENCE_RADIUS_KM=0.5

# เวลางานตามเวลาไทย; แก้แล้วรีสตาร์ท backend
WORK_START_TIME=08:30
WORK_END_TIME=17:30
LATE_GRACE_MINUTES=0
EARLY_LEAVE_GRACE_MINUTES=0
ATTENDANCE_RULES_ENABLED=true

# ความปลอดภัย
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# โฟลเดอร์เก็บรูปใบหน้าตอนเช็คอิน
STORAGE_DIR=storage

# --- แจ้งเตือนเข้ากลุ่ม LINE (Messaging API) ---
# LINE Notify ปิดบริการแล้ว ต้องใช้ LINE Official Account + Messaging API แทน
# วิธีตั้งค่าทีละขั้น: deploy/line/LINE_SETUP.md
LINE_NOTIFY_ENABLED=true
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Group ID ของกลุ่ม (ขึ้นต้นด้วย C) — เชิญบอทเข้ากลุ่มแล้วพิมพ์ "id" บอทจะบอกให้
LINE_TARGET_ID=

# เขตเวลาสำหรับแสดงเวลาในข้อความแจ้งเตือน (ไทย = 7)
TIMEZONE_OFFSET_HOURS=7

# โดเมนที่อนุญาตให้เรียก API จากเบราว์เซอร์ (คั่นด้วยจุลภาค, "*" = ทุกโดเมน)
# production ผ่าน Cloudflare Tunnel เป็น same-origin อยู่แล้ว จึงตั้งเป็นโดเมนจริงได้เลย
ALLOWED_ORIGINS=https://thanakronpart-time.com,https://www.thanakronpart-time.com,https://api.thanakronpart-time.com

# --- กล้องวงจรปิด ONVIF (ดูภาพสด + หมุนกล้อง จากแอปหัวหน้า) ---
# กล้องเป็น IP ในวง LAN ของออฟฟิศ เซิร์ฟเวอร์จึงต้องอยู่วงเดียวกับกล้อง
# ถ้าเครื่องที่รัน backend ไม่มีกล้อง ให้ตั้ง CAMERA_PTZ_ENABLED=false
# ทุก endpoint /camera/* จำกัดเฉพาะบัญชีหัวหน้า (is_manager)
# ทดสอบว่าคุยกับกล้องได้ไหม: python camera_onvif.py
CAMERA_PTZ_ENABLED=true
CAMERA_PTZ_HOST=192.168.1.101
CAMERA_PTZ_PORT=80

# กล้องที่ตั้งรหัสผ่านไว้ค่อยใส่ ปล่อยว่างถ้ากล้องไม่ได้ตั้ง
CAMERA_PTZ_USERNAME=
CAMERA_PTZ_PASSWORD=

# ความเร็วหมุน/ซูม (0..1)
CAMERA_PTZ_SPEED=0.6
CAMERA_PTZ_ZOOM_SPEED=0.6

# กดปุ่ม 1 ครั้ง = หมุนกี่มิลลิวินาทีแล้วหยุดเอง และเพดานที่ยอมให้ client ขอได้
CAMERA_PTZ_DURATION_MS=600
CAMERA_PTZ_MAX_DURATION_MS=3000

# ติดกล้องกลับด้าน/แขวนเพดาน แล้วกดขึ้นได้ลง ค่อยเปิดสองตัวนี้
CAMERA_PTZ_INVERT_PAN=false
CAMERA_PTZ_INVERT_TILT=false

CAMERA_TIMEOUT_SECONDS=8.0

# --- ฟังเสียงจากไมค์กล้อง (ต้องมี ffmpeg บนเครื่อง server) ---
# เป็นเสียงขาเข้าอย่างเดียวในระบบปัจจุบัน
# กล้อง iCam365 พูดกลับได้ผ่านแอปผู้ผลิต แต่ไม่เปิด RTSP backchannel มาตรฐาน
# ไม่มี ffmpeg = ปุ่มฟังเสียงจะไม่ขึ้นในแอปเอง ส่วนภาพ/หมุนกล้องยังใช้ได้ปกติ
CAMERA_AUDIO_ENABLED=true
CAMERA_RTSP_URL=rtsp://192.168.1.101:554
CAMERA_AUDIO_BITRATE=32k

# เว้นว่าง = ให้ระบบหา ffmpeg เอง (PATH หรือที่ chocolatey ติดตั้ง)
FFMPEG_PATH=

# --- พูดออกลำโพงกล้อง iCam365 ผ่าน Tange TiRTC ---
# สมัคร/ขอเปิดใช้งานจาก business@tange.ai ก่อน แล้วค่อยเปิด true
# SecretKeyId อยู่ได้เฉพาะไฟล์ .env ของ backend ห้ามใส่ใน Flutter หรือ commit
CAMERA_TIRTC_ENABLED=false
CAMERA_TIRTC_APP_ID=
CAMERA_TIRTC_ACCESS_KEY_ID=
CAMERA_TIRTC_SECRET_KEY_ID=
CAMERA_TIRTC_REMOTE_ID=

# Token ใช้ครั้งละสั้น ๆ: อนุญาต 30..300 วินาที
CAMERA_TIRTC_TOKEN_TTL_SECONDS=120

# ค่าแนะนำในเอกสาร Tange สำหรับไมค์ talkback (ช่วงที่ใช้ได้คือ 0..15)
CAMERA_TIRTC_STREAM_ID=14
